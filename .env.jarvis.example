# Copy to ~/jarvis/.env and fill in.

# Cerebras inference key (free): https://cloud.cerebras.ai  -> API Keys
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ONE phone number or Apple ID email allowed to talk to JARVIS — every
# other sender is blocked, logged, and alerts you once. For phone-only
# access (recommended — keeps it locked to your number, not any Apple ID
# email also linked to your account), use international format, e.g.
# +447823753000. Do NOT put an email here unless you specifically want
# email-based access instead of phone-based.
MY_IMESSAGE_ID=+447823753000

# Optional overrides:
# CEREBRAS_MODEL=llama-3.3-70b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
